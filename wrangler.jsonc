{
  // Deploy config for Cloudflare Workers with static assets.
  //
  // There is no Worker code here — no "main" entrypoint — because the game is
  // a purely static bundle. Declaring "assets" alone is enough for `wrangler
  // deploy` to upload dist/ and serve it; the Worker exists only as the thing
  // that holds the assets.
  //
  // dist/_headers (copied from public/ by Vite) carries the cache policy and
  // is honoured natively here, same as it would be on Pages.
  "name": "chromaflow-game",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist"
  }
}
